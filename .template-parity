# Files this repository shares with modern-webapp-template and must keep
# byte-identical to its default branch. scripts/check-template-parity.sh
# fetches each from the template and compares on every pull request, so a
# port that grows past the template is caught there rather than in the next
# audit. A change to one of these lands in the template first.
#
# Format: one path per line; the first line names the template.
template: neb-abera/modern-webapp-template
scripts/check-held-majors.sh
scripts/check-lts-majors.sh
scripts/held-majors.mjs
scripts/held-nuget-majors.cs
scripts/check-template-parity.sh
scripts/check-prose.sh
.vale.ini
.vale/fixtures/fails.md
.vale/fixtures/passes.md
.vale/styles/Abera/Buzzwords.yml
.vale/styles/Abera/Cliches.yml
.vale/styles/Abera/Dash.yml
.vale/styles/Abera/Exclamation.yml
.vale/styles/Abera/Hedges.yml
.vale/styles/Abera/Intensifiers.yml
.vale/styles/Abera/Jargon.yml
.vale/styles/Abera/Pivot.yml
.vale/styles/Abera/Preamble.yml
.vale/styles/Abera/Rhetorical.yml
.vale/styles/Abera/Semicolon.yml
scripts/check-attribution.sh
scripts/check-required-contexts.sh
