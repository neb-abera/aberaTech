<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- xunit.v3 test projects are executables: the runner is linked in. -->
    <OutputType>Exe</OutputType>
    <!-- dotnet test runs these through VSTest and xunit.runner.visualstudio,
         which is what coverlet.collector, the Category trait filter and the
         summary line scripts/check-server-tests.sh reads all work with.
         xunit.v3 turns on Microsoft.Testing.Platform by default, and on the
         .NET 10 SDK that refuses the VSTest path. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <UseMicrosoftTestingPlatformRunner>false</UseMicrosoftTestingPlatformRunner>
    <!-- xUnit1051 asks every call that takes a CancellationToken to pass
         TestContext.Current.CancellationToken, so a cancelled run stops
         sooner. It fired on 229 call sites when xunit.v3 arrived. It changes
         how fast an aborted run exits, never what a test proves, so it is off
         here rather than failing the build under TreatWarningsAsErrors. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <!-- The scheduling domain is the reason this project exists; warnings in it
         are the kind that hide a real defect, so they fail the build. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- The fitness endpoint tests count database commands, which only a
         relational provider sends; SQLite is the one that needs no server. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <!-- Line-coverage collection (the "XPlat Code Coverage" collector); the
         Dockerfile's servertest stage parses the cobertura report and fails
         the build below its floor. -->
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <!-- The least-privilege grants are tested by running the checked-in script
       itself, not a copy of it. -->
  <ItemGroup>
    <None Include="..\aberaTech.Postgres\Sql\least-privilege.sql" Link="Sql\least-privilege.sql" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Fitness\Golden\*.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aberaTech.Fitness\aberaTech.Fitness.csproj" />
    <ProjectReference Include="..\aberaTech.Scheduling\aberaTech.Scheduling.csproj" />
    <ProjectReference Include="..\aberaTech.Server\aberaTech.Server.csproj" />
  </ItemGroup>

</Project>
