<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The fitness feature as a library, for the same two reasons scheduling is
    one: the prediction engine is pure math that knows nothing about HTTP, and
    referencing the server would drag the Node toolchain into running its unit
    tests.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.AspNetCore.RateLimiting" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="aberaTech.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\aberaTech.Postgres\aberaTech.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Garmin's own FIT decoder, published by Garmin on NuGet. Parsing the
         binary FIT format by hand is how you get subtly wrong heart-rate data;
         the vendor's decoder is the one engine for that behaviour. -->
    <PackageReference Include="Garmin.FIT.Sdk" />
    <PackageReference Include="NodaTime" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
