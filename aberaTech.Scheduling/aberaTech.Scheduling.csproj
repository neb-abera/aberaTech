<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The scheduling feature as a library rather than a folder inside the web
    project.

    Two reasons, and the second is the one that bites. It is the right shape: the
    domain is pure, knows nothing about HTTP, and the web project's job is to
    host and compose it. And aberaTech.Server references the client esproj, so
    anything referencing the server needs Node installed to build — which would
    make running the scheduling unit tests depend on a JavaScript toolchain that
    has nothing to do with them.
  -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- For the endpoint, hosted service and logging types. A framework reference
       rather than packages: these ship with the shared runtime the server
       already runs on. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Microsoft.NET.Sdk.Web supplies these implicitly; a plain library SDK does
    not, so they are declared rather than repeated at the top of every file.
  -->
  <!-- The test project sees internals. Parsing a Google response and similar
       seams are worth asserting directly, but they are not API anybody outside
       this library should call, so they stay internal rather than being made
       public to suit the tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="aberaTech.Server.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.AspNetCore.RateLimiting" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="9.0.4" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="NodaTime" Version="3.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="9.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="9.0.4" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
